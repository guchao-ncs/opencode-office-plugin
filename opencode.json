{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow"
  },
  "mcp": {
    "word": {
      "type": "local",
      "command": ["uv", "run", "--with", "word-mcp-live", "scripts/word_mcp_launcher.py"],
      "enabled": true,
      "timeout": 90000,
      "environment": {
        "MCP_AUTHOR": "Gu Chao",
        "MCP_AUTHOR_INITIALS": "GC"
      }
    },
    "powerpoint": {
      "type": "local",
      "command": ["uvx", "ppt-mcp"],
      "enabled": true,
      "timeout": 90000,
      "environment": {
        "MCP_AUTHOR": "Gu Chao",
        "MCP_AUTHOR_INITIALS": "GC",
        "PPT_AUTO_DISMISS_DIALOG": "true"
      }
    },
    "excel": {
      "type": "local",
      "command": ["uv", "run", "scripts/excel_mcp_server.py"],
      "enabled": true,
      "timeout": 90000
    }
  }
}
